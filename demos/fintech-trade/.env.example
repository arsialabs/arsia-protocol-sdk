# ARSIA Protocol — Fintech Trade Demo
# Copy to .env and adjust as needed.

# ── Agent A: Client Advisor ─────────────────────────────────
AGENT_A_ID=agent:acme.advisor
AGENT_A_PORT=8001
AGENT_A_OLLAMA_URL=http://localhost:11434
AGENT_A_OLLAMA_MODEL=gemma4:e2b
AGENT_A_CAPABILITIES=client.profile,trade.request

# ── Agent B: Risk Assessor ──────────────────────────────────
AGENT_B_ID=agent:acme.risk-assessor
AGENT_B_PORT=8002
AGENT_B_OLLAMA_URL=http://localhost:11435
AGENT_B_OLLAMA_MODEL=gemma4:e2b
AGENT_B_CAPABILITIES=risk.assess

# ── Agent C: Trade Executor ─────────────────────────────────
AGENT_C_ID=agent:acme.trade-executor
AGENT_C_PORT=8003
AGENT_C_OLLAMA_URL=http://localhost:11436
AGENT_C_OLLAMA_MODEL=gemma4:e2b
AGENT_C_CAPABILITIES=trade.execute

# ── Dashboard ───────────────────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_AGENT_A_URL=http://localhost:8001

# ── Single Ollama override ──────────────────────────────────
# Uncomment these to point all agents at one Ollama instance:
# AGENT_A_OLLAMA_URL=http://localhost:11434
# AGENT_B_OLLAMA_URL=http://localhost:11434
# AGENT_C_OLLAMA_URL=http://localhost:11434
