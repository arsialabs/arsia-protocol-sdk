# ARSIA Protocol — Healthcare Data Pipeline Demo
# Copy to .env and adjust as needed.

# ── Agent A: Data Collector ────────────────────────────────
AGENT_A_ID=agent:meddata.data-collector
AGENT_A_PORT=8001
AGENT_A_OLLAMA_URL=http://localhost:11434
AGENT_A_OLLAMA_MODEL=gemma4:e2b
AGENT_A_CAPABILITIES=patient.collect,patient.result

# ── Agent B: Anonymizer ───────────────────────────────────
AGENT_B_ID=agent:meddata.anonymizer
AGENT_B_PORT=8002
AGENT_B_OLLAMA_URL=http://localhost:11435
AGENT_B_OLLAMA_MODEL=gemma4:e2b
AGENT_B_CAPABILITIES=pii.strip

# ── Agent C: Clinical Analyzer ────────────────────────────
AGENT_C_ID=agent:meddata.clinical-analyzer
AGENT_C_PORT=8003
AGENT_C_OLLAMA_URL=http://localhost:11436
AGENT_C_OLLAMA_MODEL=gemma4:e2b
AGENT_C_CAPABILITIES=analysis.interpret

# ── Dashboard ─────────────────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_AGENT_A_URL=http://localhost:8001

# ── Single Ollama override ────────────────────────────────
# Uncomment these to point all agents at one Ollama instance:
# AGENT_A_OLLAMA_URL=http://localhost:11434
# AGENT_B_OLLAMA_URL=http://localhost:11434
# AGENT_C_OLLAMA_URL=http://localhost:11434
