# ARSIA Protocol — Healthcare Data Pipeline Demo
# Copy to .env and adjust as needed.

# ── Agent A: Data Collector ────────────────────────────────
AGENT_A_ID=agent:meddata.data-collector
AGENT_A_PORT=8001
AGENT_A_CAPABILITIES=patient.collect,patient.result

# ── Agent B: Anonymizer ───────────────────────────────────
AGENT_B_ID=agent:meddata.anonymizer
AGENT_B_PORT=8002
AGENT_B_CAPABILITIES=pii.strip

# ── Agent C: Clinical Analyzer ────────────────────────────
AGENT_C_ID=agent:meddata.clinical-analyzer
AGENT_C_PORT=8003
AGENT_C_CAPABILITIES=analysis.interpret

# ── Dashboard ─────────────────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_AGENT_A_URL=http://localhost:8001

# ── LLM (one for the whole demo) ────────────────────────────
# DEMO_LLM: ollama (default, the Ollama on this machine), openai, anthropic,
# gemini, or none (no LLM: deterministic fallback responses).
DEMO_LLM=ollama
# Model; the default depends on DEMO_LLM: gemma4:e2b, gpt-4.1-nano,
# claude-haiku-5-5 or gemini-3.5-flash-lite.
# DEMO_LLM_MODEL=
# Ollama mode: where the host's Ollama listens.
# DEMO_OLLAMA_URL=http://localhost:11434
# Provider modes: your own API key for the provider you choose.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Advanced, for testing only: send provider requests to another address.
# DEMO_LLM_BASE_URL=
